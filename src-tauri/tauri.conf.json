{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helix",
  "version": "../package.json",
  "identifier": "com.helix-desktop.helix",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "project",
        "create": false,
        "title": "Helix",
        "width": 1000,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 28 },
        "transparent": true,
        "windowEffects": { "effects": ["sidebar"] }
      },
      {
        "label": "engine",
        "url": "engine.html",
        "visible": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDRTBCQ0RBQzQ0REM0MDYKUldRR3hFM0UycnpnVE5IQnhrdUpJa2ZzQzRyQ2lUbUFEL2QrcGxvMDFJK0RlZXhNQU1tcWtDQ28K",
      "endpoints": ["https://github.com/mickaphd/Helix/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "copyright": "© 2026 mickaphd",
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": { "../samples/Helix Sample.hlx": "Helix Sample.hlx" },
    "fileAssociations": [{ "ext": ["hlx"], "name": "Helix Project", "role": "Editor" }],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 185 },
        "applicationFolderPosition": { "x": 480, "y": 185 }
      }
    }
  }
}
